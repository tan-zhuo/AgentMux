# Build output. The suffixed names are the headless server build and the
# throwaway binary used to run a second instance while the app is open.
/agentmux
/agentmux-*
/agentmux.exe
# Anything under tools/ compiled with `go build ./tools/...`.
/icongen
/icongen.exe
# Go leaves a `~` backup of the previous binary when it relinks in place.
*.exe~
/bin/
/dist/
*.log

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo

# Local editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.gstack/
